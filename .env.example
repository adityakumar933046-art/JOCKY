# ==============================================================================
# JOCKY Central Forensic Platform - Environment Configuration Example
# Copy this file to '.env' and customize for your deployment environment.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# Environment mode: 'development', 'testing', or 'production'
JOCKY_ENV=development

# Core Server Secret Key (MUST be at least 32 characters in production)
JOCKY_SECRET_KEY=dev-test-secret-key-32-chars-minimum-entropy-required-12345

# Database Connection URL (SQLite default for local dev; PostgreSQL supported)
JOCKY_DATABASE_URL=sqlite:///./jocky_central.db
# JOCKY_DATABASE_URL=postgresql://user:password@localhost:5432/jocky

# Authentication & Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=60
JOCKY_PBKDF2_ITERATIONS=100000

# Account Lockout Policy
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Agent & Analyst Shared Secret Fallbacks (Change in production)
JOCKY_AGENT_SECRET=jocky-agent-secret-key-2026
JOCKY_ANALYST_SECRET=jocky-analyst-secret-key-2026
