# ==============================================================================
# JOCKY Central Forensic Platform - Production Environment Configuration
# Copy this file to '.env' and populate with your production values.
# NEVER commit your actual '.env' containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Debug
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
PORT=8000

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets (MUST be at least 32 characters in production)
# ------------------------------------------------------------------------------
SECRET_KEY=generate-at-least-32-character-high-entropy-secret-key-here
JWT_SECRET=generate-at-least-32-character-high-entropy-secret-key-here
JOCKY_SECRET_KEY=generate-at-least-32-character-high-entropy-secret-key-here

# ------------------------------------------------------------------------------
# 3. Database Connection
# SQLite (Development default):
# DATABASE_URL=sqlite:///./jocky_central.db
# PostgreSQL (Production recommended):
DATABASE_URL=postgresql://jocky_admin:YOUR_SECURE_PASSWORD@localhost:5432/jocky
JOCKY_DATABASE_URL=postgresql://jocky_admin:YOUR_SECURE_PASSWORD@localhost:5432/jocky

# ------------------------------------------------------------------------------
# 4. Networking, CORS & URLs
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. In production, restrict to your frontend domain.
CORS_ORIGINS=https://your-domain.com,https://your-frontend.vercel.app
API_BASE_URL=https://your-domain.com/api/v1
FRONTEND_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# 5. Security & Authentication Parameters
# ------------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=120
JOCKY_PBKDF2_ITERATIONS=310000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ------------------------------------------------------------------------------
# 6. Distributed Agent Settings
# ------------------------------------------------------------------------------
JOCKY_SERVER_URL=https://your-domain.com
JOCKY_AGENT_SECRET=generate-per-organization-high-entropy-agent-secret
JOCKY_ANALYST_SECRET=generate-per-organization-high-entropy-analyst-secret
